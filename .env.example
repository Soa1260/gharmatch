# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (use the "pooled" host). Local Postgres also works.
DATABASE_URL="postgresql://user:password@localhost:5432/gharmatch"

# Auth.js
AUTH_SECRET=""            # generate with: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: email to people whose report or appeal was decided (Resend). Sign-in is Google only.
RESEND_API_KEY=""
EMAIL_FROM="Gharmatch <login@example.com>"

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=""

# Public contact for the grievance page
NEXT_PUBLIC_GRIEVANCE_EMAIL="grievance@example.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2 (photos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Vercel cron calls /api/cron/daily with this bearer token
CRON_SECRET=""

# Optional. Free Google Maps Embed API key restricted to your site address. Without it the keyless embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""
